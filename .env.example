# ─────────────────────────────────────────────────────────────────────────────
# La Pizarra — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Variables marked [prod] are only needed in production (Vercel).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection string. Local default matches docker-compose.yml.
# In production use the *pooled* Neon connection string.
DATABASE_URL=postgresql://lapizarra:lapizarra@localhost:5432/lapizarra

# Database used by automated tests (created by docker/initdb on first start).
TEST_DATABASE_URL=postgresql://lapizarra:lapizarra@localhost:5432/lapizarra_test

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public address of the site, no trailing slash. Used for links in emails,
# RSS, sitemap, Open Graph tags and live preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string that protects the draft preview route.
PREVIEW_SECRET=

# Random string (16+ chars) that authorizes the scheduled-publishing job
# runner (GET /api/payload-jobs/run). Must match the GitHub Actions secret.
CRON_SECRET=

# ── Media storage: Cloudflare R2 [prod] ──────────────────────────────────────
# Leave R2_BUCKET empty in development: uploads are saved to ./media on disk.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public address files are served from (custom domain or *.r2.dev), no slash.
R2_PUBLIC_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# Provider is chosen automatically: RESEND_API_KEY set → Resend;
# SMTP_HOST set → SMTP; neither → emails are printed to the console (dev).
EMAIL_FROM_ADDRESS=redaccion@example.com
EMAIL_FROM_NAME=La Pizarra
# Where contact messages and story submissions are sent.
EDITOR_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Spam protection: Cloudflare Turnstile ────────────────────────────────────
# Leave empty in development to skip the check. Cloudflare's always-pass test
# keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (cookie-less) ──────────────────────────────────────────────────
# "true" enables Vercel Web Analytics. No cookies, no ad trackers.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── Sample content (development only) ────────────────────────────────────────
# Password for the four sample accounts created by `pnpm seed`
# (admin@, editor@, maestra@, estudiante@lapizarra.test). 12+ characters,
# mixing upper/lowercase, numbers and symbols.
SEED_PASSWORD=
